#!/usr/bin/env python3
"""bakehouse: the team's command. The plugin's bin/ is on the Bash tool's PATH. Standard library only.

  bakehouse setup [--pointer <main clone>] [--pre-commit] [--no-remote-check]   make this clone ready for its team
                                  (runtime/bakehouse_setup.py; bakehouse setup --help lists the options)
  bakehouse status [--json] [--since <ISO time>] [--repo <folder>]   the team's state (runtime/bakehouse_status.py)
  bakehouse ground [--json] [--days N] [--not <work order>] [--repo <folder>] <path>...   which work orders changed
                                  these files or folders lately (runtime/bakehouse_ground.py)
  bakehouse record commit <record folder> -m <message> [-m ...]   check and commit one run folder on the records
                                  branch (runtime/bakehouse_record.py)
  bakehouse sync [--repo <folder>]   fetch, merge and push the records branch, in records format 2
                                  (runtime/records_sync.py)
  bakehouse reserve [--start] [--repo <folder>]   print the next free work-order id and record it on the records
                                  branch; --start, once per project, records the floor (runtime/reserve.py)
  bakehouse run <script> [args]   run runtime/<script> with the args: the stable way to name a plugin script,
                                  since the plugin folder changes on every update
"""
import importlib
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "runtime"))
COMMANDS = {"record": "bakehouse_record", "sync": "records_sync", "reserve": "reserve", "setup": "bakehouse_setup",
            "status": "bakehouse_status", "ground": "bakehouse_ground"}


def run(argv) -> int:
    """Exec runtime/<script> with the args; its exit code is the command's. A .py runs under this python,
    because not every script is executable."""
    if not argv:
        print("usage: bakehouse run <script> [args]", file=sys.stderr)
        return 2
    name, path = argv[0], ROOT / "runtime" / argv[0]
    if "/" in name or not path.is_file():
        print(f"bakehouse run: {name!r} is not a script in {ROOT / 'runtime'}", file=sys.stderr)
        return 2
    cmd = [sys.executable, str(path)] if path.suffix == ".py" else [str(path)]
    try:
        os.execv(cmd[0], cmd + argv[1:])
    except OSError as e:
        print(f"bakehouse run: cannot run {path}: {e}", file=sys.stderr)
        return 126


def main(argv) -> int:
    if argv and argv[0] == "run":
        return run(argv[1:])
    if not argv or argv[0] not in COMMANDS:
        print(f"usage: bakehouse <{'|'.join([*COMMANDS, 'run'])}> ...", file=sys.stderr)
        return 2
    return importlib.import_module(COMMANDS[argv[0]]).main(argv[1:], ROOT)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
